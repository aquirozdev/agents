# Runtime configuration for the reusable banking gateway contract.
# Keep access tokens in a secret manager; do not put them in this file.
BANKING_GATEWAY_BASE_URL=https://banking-gateway.example.internal

# Only for the local executable gateway demo. Use a secret manager in real deployments.
BANKING_ENVIRONMENT=development
BANKING_INSTITUTION_ID=cooperative-demo
BANKING_INSTITUTION_NAME=Cooperativa Demo
BANKING_INSTITUTION_CONFIG=
BANKING_CONNECTOR=demo
BANKING_CONNECTOR_FACTORY=
BANKING_AUTH_MODE=static-demo
BANKING_GATEWAY_TOKEN=local-demo-token
BANKING_PUBLIC_GATEWAY_TOKEN=local-public-token
BANKING_DEMO_SUBJECT=customer-demo-001
BANKING_VERIFIED_SUBJECT_HEADER=X-Verified-Subject
BANKING_VERIFIED_SESSION_STATE_HEADER=X-Verified-Session-State
BANKING_REQUIRE_VERIFIED_SESSION_FOR_PRIVATE_DATA=true
BANKING_DIFY_IDENTITY_HEADER=X-Dify-End-User-ID
BANKING_DIFY_IDENTITY_SIGNATURE_HEADER=X-Dify-End-User-Signature
BANKING_DIFY_IDENTITY_SECRET=

# Identity flow for web and WhatsApp. The local provider is rejected when
# BANKING_ENVIRONMENT=production.
BANKING_AUTH_STATE_DB=/data/auth.sqlite3
BANKING_AUTH_BASE_URL=http://localhost:8080
BANKING_AUTH_VERIFICATION_MODE=local-acceptance
BANKING_AUTH_OTP_PROVIDER=local-acceptance
BANKING_AUTH_IDENTITY_SECRET=local-auth-identity-secret
BANKING_AUTH_CUSTOMER_DIRECTORY=
BANKING_AUTH_CHALLENGE_TTL_SECONDS=300
BANKING_AUTH_SESSION_TTL_SECONDS=900
BANKING_AUTH_STEP_UP_TTL_SECONDS=300

# Twilio Verify v2. Required only when BANKING_AUTH_OTP_PROVIDER=twilio-verify.
# Keep these values in the environment or a secret manager, never in git.
BANKING_TWILIO_ACCOUNT_SID=
BANKING_TWILIO_AUTH_TOKEN=
BANKING_TWILIO_VERIFY_SERVICE_SID=

# Optional local Fineract connector. Keep false/demo for a core-agnostic deployment.
BANKING_FINERACT_BASE_URL=https://fineract:8443/fineract-provider/api/v1
BANKING_FINERACT_USERNAME=mifos
BANKING_FINERACT_PASSWORD=password
BANKING_FINERACT_TENANT=default
BANKING_FINERACT_VERIFY_TLS=false

# Optional when the institution already exposes the canonical API from a BFF.
BANKING_UPSTREAM_BASE_URL=
BANKING_UPSTREAM_TOKEN=
BANKING_UPSTREAM_VERIFY_TLS=true
BANKING_UPSTREAM_TIMEOUT_SECONDS=15
BANKING_UPSTREAM_CONNECT_TIMEOUT_SECONDS=5

# Optional WhatsApp Cloud API channel. Keep all values in a secret manager.
BANKING_WHATSAPP_ENABLED=false
BANKING_WHATSAPP_VERIFY_TOKEN=
BANKING_WHATSAPP_APP_SECRET=
BANKING_WHATSAPP_IDENTITY_SECRET=local-auth-identity-secret
BANKING_WHATSAPP_ACCESS_TOKEN=
BANKING_WHATSAPP_PHONE_NUMBER_ID=
BANKING_WHATSAPP_GRAPH_API_VERSION=v23.0
BANKING_DIFY_BASE_URL=http://dify-api:5001
BANKING_DIFY_API_KEY=
BANKING_DIFY_PUBLIC_API_KEY=
BANKING_DIFY_CUSTOMER_API_KEY=
