# OIDC settings for the optional identity-aware reverse proxy.
IDENTITY_PROXY_ENVIRONMENT=development
IDENTITY_PROXY_ISSUER=https://idp.example.com/realms/cooperative
IDENTITY_PROXY_JWKS_URL=https://idp.example.com/realms/cooperative/protocol/openid-connect/certs
IDENTITY_PROXY_AUDIENCE=banking-agent
IDENTITY_PROXY_ALGORITHMS='["RS256"]'
IDENTITY_PROXY_SUBJECT_CLAIM=sub
IDENTITY_PROXY_SESSION_ID_CLAIM=sid
IDENTITY_PROXY_ASSURANCE_CLAIM=acr
IDENTITY_PROXY_VERIFIED_ASSURANCE_VALUES='["mfa","verified","urn:institution:mfa"]'
IDENTITY_PROXY_GATEWAY_BASE_URL=http://banking-gateway:8080
IDENTITY_PROXY_GATEWAY_TOKEN=
IDENTITY_PROXY_INSTITUTION_ID=cooperative-demo
IDENTITY_PROXY_DIFY_RELAY_SECRET=
IDENTITY_PROXY_IDENTITY_ASSERTION_SECRET=
IDENTITY_PROXY_DIFY_IDENTITY_HEADER=X-Dify-End-User-ID
IDENTITY_PROXY_DIFY_IDENTITY_SIGNATURE_HEADER=X-Dify-End-User-Signature
IDENTITY_PROXY_VERIFIED_SUBJECT_HEADER=X-Verified-Subject
IDENTITY_PROXY_VERIFIED_SESSION_STATE_HEADER=X-Verified-Session-State
IDENTITY_PROXY_SESSION_ID_HEADER=X-Session-ID
IDENTITY_PROXY_CORRELATION_ID_HEADER=X-Correlation-ID
IDENTITY_PROXY_MAX_BODY_BYTES=1048576
